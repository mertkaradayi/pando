#!/usr/bin/env bash
#
# Try a branch of pando on your own machine before it is pushed or released.
#
# Every branch gets a worktree of its own beside the main checkout, and its
# own build there. Nothing here pushes, merges or releases anything.
#
#   scripts/dev new <name> [<from>]      a branch and a worktree for it, from main
#   scripts/dev use <name>               `pando` everywhere is that branch's build
#   scripts/dev use release              `pando` is the release you installed again
#   scripts/dev ls                       every worktree, and which build `pando` runs
#   scripts/dev which                    what `pando` runs: `release`, `main`, or a branch and its label
#   scripts/dev path <name>              a worktree's path
#   scripts/dev build [<name>]           cargo build --release in that worktree
#   scripts/dev run <name> [<args>...]   build it, then run that pando once, here, with the args
#   scripts/dev try <name> [<fixture>]   that pando's TUI in a throwaway fixture repo
#   scripts/dev rm <name>                remove the worktree; the branch stays
#   scripts/dev install                  link this script as ~/bin/pando-dev
#
# <name> is a worktree's directory name or its branch; `main` is the main
# checkout. With no <name>, `build` takes the worktree you are standing in.
#
# `use` is how a branch is lived with: after `pando-dev use my-feature`,
# `pando` in any project is that build, on your real worktrees and your own
# ~/.pando, and its header says `⎇ my-feature@<sha>` so it never passes for
# the released one. `use release` takes the link away, so `pando` is the
# release again, from Homebrew or wherever it was installed; `use main` is
# the main checkout's own build, which is not the release.
#
# `try` builds the fixture from that branch's own recipe
# (scripts/fixture-repo.sh <fixture> --with-origin --listener, `plain` by
# default) under $TMPDIR, with a PANDO_HOME beside it, so neither a real
# repository nor your own ~/.pando is touched.
#
# `use` manages one symlink, $PANDO_DEV_LINK (default ~/bin/pando), and
# refuses to replace anything that is not a symlink, such as a pando that
# Homebrew installed. Worktrees go in $PANDO_DEV_WORKTREES, default
# <main checkout>.worktrees, beside it rather than inside it.

set -euo pipefail

script=$(realpath "${BASH_SOURCE[0]}")
here=$(dirname "$(dirname "$script")")
main=$(dirname "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)")
worktrees=${PANDO_DEV_WORKTREES:-$main.worktrees}
link=${PANDO_DEV_LINK:-$HOME/bin/pando}

die() { printf 'pando-dev: %s\n' "$*" >&2; exit 1; }
say() { printf 'pando-dev: %s\n' "$*" >&2; }

# The worktree a name stands for: `main`, a directory name, or a branch.
resolve() {
  local name=$1 path="" branch=""
  if [[ $name == main ]]; then
    echo "$main"
    return
  fi
  while IFS= read -r line; do
    case $line in
      "worktree "*) path=${line#worktree } ;;
      "branch refs/heads/"*)
        branch=${line#branch refs/heads/}
        if [[ $(basename "$path") == "$name" || $branch == "$name" ]]; then
          echo "$path"
          return
        fi
        ;;
    esac
  done < <(git -C "$main" worktree list --porcelain)
  die "no worktree called $name — \`pando-dev ls\` lists them"
}

# The worktree the current directory is in, if it is one of pando's.
current() {
  local top
  top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a pando worktree: name one"
  [[ $(dirname "$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)") == "$main" ]] ||
    die "$top is not a pando worktree: name one"
  echo "$top"
}

label() {
  local wt=$1 branch sha past dirty
  branch=$(git -C "$wt" branch --show-current)
  sha=$(git -C "$wt" rev-parse --short HEAD)
  past=$(git -C "$wt" rev-list --count main..HEAD 2>/dev/null || echo 0)
  dirty=$(git -C "$wt" status --porcelain | wc -l | tr -d ' ')
  printf '%s @ %s' "${branch:-detached}" "$sha"
  [[ $wt != "$main" ]] && printf ', %s commit(s) past main' "$past"
  [[ $dirty != 0 ]] && printf ', %s uncommitted' "$dirty"
  return 0
}

# What a build names itself in `--version` and the TUI's header:
# `git-menu@b7bb2b4`, `+wip` with uncommitted changes in it. Nothing for
# a clean main checkout, which builds as `cargo build --release` would.
build_label() {
  local wt=$1 branch dirty
  dirty=$(git -C "$wt" status --porcelain)
  [[ $wt == "$main" && -z $dirty ]] && return 0
  branch=$(git -C "$wt" branch --show-current)
  printf '%s@%s' "${branch:-detached}" "$(git -C "$wt" rev-parse --short HEAD)"
  [[ -n $dirty ]] && printf '+wip'
  return 0
}

build() {
  local wt=$1 start tag
  start=$(date +%s)
  tag=$(build_label "$wt")
  say "building $(label "$wt")"
  if [[ -n $tag ]]; then
    PANDO_BUILD_LABEL=$tag cargo build --release --quiet --manifest-path "$wt/Cargo.toml"
  else
    env -u PANDO_BUILD_LABEL cargo build --release --quiet --manifest-path "$wt/Cargo.toml"
  fi || die "the build failed in $wt"
  say "built in $(($(date +%s) - start))s: $wt/target/release/pando"
}

# The main checkout's `target`, cloned copy-on-write into a new worktree,
# so the branch builds only pando and finds every dependency already
# built: their fingerprints name no path of the checkout. Only ever a
# clone, never a full copy: on macOS `cp -c` falls back to copying where
# it cannot clone, so it runs only when both sit on one APFS volume;
# elsewhere `--reflink=always` fails rather than copy, and the partial
# copy goes. Either way, without a clone cargo builds from nothing.
clone_target() {
  local wt=$1 cloned=false
  [[ -d $main/target && ! -e $wt/target ]] || return 0
  if [[ $(uname) == Darwin ]]; then
    one_apfs_volume "$main" "$wt" && cp -c -R "$main/target" "$wt/target" 2>/dev/null &&
      cloned=true
  else
    cp -R --reflink=always "$main/target" "$wt/target" 2>/dev/null && cloned=true
  fi
  if $cloned; then
    say "cloned the main checkout's target/ (copy-on-write): cargo builds only what the branch changed"
  else
    rm -rf "$wt/target"
  fi
}

# Whether two macOS paths sit on one APFS volume, where clonefile works.
one_apfs_volume() {
  [[ $(stat -f %d "$1") == $(stat -f %d "$2") ]] &&
    diskutil info "$(df "$1" | awk 'NR == 2 { print $1 }')" 2>/dev/null |
    grep -q 'Type (Bundle): *apfs'
}

cmd_new() {
  local name=${1:?usage: pando-dev new <name> [<from>]} from=${2:-main}
  # A branch's slashes become `+`, as pando names its own worktrees.
  local wt=$worktrees/${name//\//+}
  [[ -e $wt ]] && die "$wt already exists"
  mkdir -p "$worktrees"
  if git -C "$main" show-ref --verify --quiet "refs/heads/$name"; then
    git -C "$main" worktree add --quiet "$wt" "$name"
  else
    git -C "$main" worktree add --quiet -b "$name" "$wt" "$from"
  fi
  # The local-only material (docs/, plans/, CLAUDE.local.md) is gitignored,
  # so a new worktree has none of it. Link it in, and keep the links out
  # of `git status`: `docs/` in .gitignore matches a directory, not a
  # symlink to one, so they go in .git/info/exclude, which every worktree
  # shares and nothing commits.
  local exclude
  exclude="$(git -C "$main" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  mkdir -p "$(dirname "$exclude")"
  for item in docs plans CLAUDE.local.md; do
    [[ -e $main/$item ]] || continue
    ln -s "$main/$item" "$wt/$item"
    grep -qxF "/$item" "$exclude" 2>/dev/null || echo "/$item" >>"$exclude"
  done
  clone_target "$wt"
  say "made $wt on branch $name, from $from"
  say "next: work and commit there; \`pando-dev use $name\` makes it the \`pando\` on PATH"
  echo "$wt"
}

# `5m ago`, `2h ago`, `3d ago`: when a build was made. Whether it is
# current is cargo's to say, and `build` asks it in a second when it is.
ago() {
  local s=$(($(date +%s) - $1))
  if ((s < 3600)); then echo "$((s / 60))m ago"
  elif ((s < 86400)); then echo "$((s / 3600))h ago"
  else echo "$((s / 86400))d ago"; fi
}

cmd_ls() {
  local target="" path="" bin mark built
  [[ -L $link ]] && target=$(readlink "$link")
  while IFS= read -r line; do
    [[ $line == "worktree "* ]] || continue
    path=${line#worktree }
    bin=$path/target/release/pando
    if [[ -x $bin ]]; then
      built="built $(ago "$(stat -f %m "$bin" 2>/dev/null || stat -c %Y "$bin")")"
    else
      built="not built"
    fi
    mark="  "
    [[ $target == "$bin" ]] && mark="▸ "
    printf '%s%-18s %s · %s\n' "$mark" "$( [[ $path == "$main" ]] && echo main || basename "$path")" \
      "$(label "$path")" "$built"
  done < <(git -C "$main" worktree list --porcelain)
  if [[ -n $target ]]; then
    printf '\n▸ is what `pando` runs (%s); `pando-dev use release` goes back to the release\n' "$link"
  elif [[ -e $link ]]; then
    printf '\n%s is not a symlink pando-dev manages\n' "$link"
  else
    printf '\n`pando` is %s, no build of a worktree; `pando-dev use <name>` tries one\n' \
      "$(command -v pando || echo nothing)"
  fi
}

# The worktree `pando` on PATH runs, as a name `use` takes, and its label:
# `release` when no worktree's build is linked.
cmd_which() {
  local target path
  if [[ ! -e $link && ! -L $link ]]; then
    echo "release"
    return
  fi
  [[ -L $link ]] || die "$link is not a symlink pando-dev manages"
  target=$(readlink "$link")
  path=${target%/target/release/pando}
  [[ $path == "$target" ]] && die "$link points at $target, which no worktree built"
  if [[ $path == "$main" ]]; then
    echo "main"
  else
    printf '%s\t%s\n' "$(basename "$path")" "$(label "$path")"
  fi
}

cmd_path() {
  resolve "${1:?usage: pando-dev path <name>}"
}

cmd_build() {
  local wt
  if [[ $# -gt 0 ]]; then wt=$(resolve "$1"); else wt=$(current); fi
  build "$wt"
}

cmd_run() {
  local wt
  wt=$(resolve "${1:?usage: pando-dev run <name> [<args>...]}")
  shift
  build "$wt"
  exec "$wt/target/release/pando" "$@"
}

cmd_use() {
  local wt bin
  if [[ ${1:-} == release ]]; then
    release
    return
  fi
  wt=$(resolve "${1:?usage: pando-dev use <name>}")
  bin=$wt/target/release/pando
  if [[ -e $link && ! -L $link ]]; then
    die "$link is a file, not a symlink: pando-dev will not replace it"
  fi
  build "$wt"
  mkdir -p "$(dirname "$link")"
  ln -sfn "$bin" "$link"
  say "\`pando\` is now $(label "$wt")"
  say "\`pando-dev use release\` goes back to the release"
  local found
  found=$(command -v pando || true)
  if [[ $found != "$link" ]]; then
    say "warning: \`pando\` on your PATH is ${found:-nothing}, not $link — put $(dirname "$link") first in PATH"
  fi
  # A shell remembers where it found a command, and a new one earlier in
  # PATH does not change its mind; one that is gone, zsh looks for again.
  say "a shell that ran \`pando\` before may run the old one until \`rehash\` (zsh) or \`hash -r\` (bash)"
}

# `use release`: the link goes, so `pando` is whatever PATH finds without
# it — the release, from Homebrew or wherever it was installed.
release() {
  if [[ -e $link && ! -L $link ]]; then
    die "$link is a file, not a symlink: pando-dev will not remove it"
  fi
  if [[ -L $link ]]; then
    rm "$link"
  fi
  local found
  found=$(command -v pando || true)
  if [[ -z $found ]]; then
    say "\`pando\` is nothing now: \`brew install mertkaradayi/tap/pando\` installs the release, \`pando-dev use main\` builds the main checkout's"
    return 0
  fi
  say "\`pando\` is now $("$found" --version), at $found"
}

cmd_try() {
  local wt fixture parent home
  wt=$(resolve "${1:?usage: pando-dev try <name> [<fixture> [<flags>...]]}")
  shift
  local kind=${1:-plain}
  [[ $# -gt 0 ]] && shift
  build "$wt"
  say "building a $kind fixture with that branch's recipe (the first time compiles the builder)"
  local log
  log=$(mktemp)
  if ! fixture=$("$wt/scripts/fixture-repo.sh" "$kind" --with-origin --listener "$@" 2>"$log"); then
    cat "$log" >&2
    die "the fixture did not build"
  fi
  rm -f "$log"
  parent=$(dirname "$fixture")
  home=$parent/pando-home
  mkdir -p "$home"
  say "fixture  $fixture"
  say "home     $home"
  say "running  $(label "$wt") — quit with q; the fixture stays until you remove $parent"
  cd "$fixture"
  PANDO_HOME=$home PATH="$wt/target/release:$PATH" exec "$wt/target/release/pando"
}

cmd_rm() {
  local wt
  wt=$(resolve "${1:?usage: pando-dev rm <name>}")
  [[ $wt == "$main" ]] && die "that is the main checkout"
  local branch
  branch=$(git -C "$wt" branch --show-current)
  # Not the main checkout's build, which may be stale or never built.
  if [[ -L $link && $(readlink "$link") == "$wt/"* ]]; then
    say "\`pando\` ran this worktree's build, so it goes back to the release"
    release
  fi
  # The links to the local material are not git's to remove.
  for item in docs plans CLAUDE.local.md; do
    [[ -L $wt/$item ]] && rm "$wt/$item"
  done
  git -C "$main" worktree remove "$wt"
  say "removed $wt; the branch ${branch:-?} stays (git branch -d ${branch:-<branch>} deletes it once merged)"
}

cmd_install() {
  mkdir -p "$HOME/bin"
  ln -sfn "$script" "$HOME/bin/pando-dev"
  say "linked $HOME/bin/pando-dev → $script"
}

case ${1:-} in
  new | ls | which | path | build | run | use | try | rm | install)
    sub=$1
    shift
    "cmd_$sub" "$@"
    ;;
  "" | -h | --help | help)
    awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$script"
    ;;
  *) die "no command $1 — pando-dev help lists them" ;;
esac
